<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="dlgMatchDetail"
          title="{dlg>/title}"
          titleAlignment="Center"
          contentWidth="1000px"
          contentHeight="705px"
          class="sapUiNoContentPadding fragmentteste">

    <VBox class="sapUiSmallMargin" fitContainer="true">
      <HBox justifyContent="SpaceAround" renderType="Bare" width="100%">

        <!-- ================= TIME AZUL ================= -->
        <VBox width="47%">
          <Title text="Time Azul" level="H4" width="100%" textAlign="Begin" class="sapUiSmallMarginBottom titleBlue"/>
          <VBox items="{dlg>/team100}">
            <items>
              <HBox alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="sapUiTinyMarginBottom playerRow"
                    width="100%">

                <!-- ESQUERDA: Nome em cima, campeão abaixo, spells embaixo -->
                <VBox width="45%" alignItems="Start">
                  <VBox class="playerBox" alignItems="Center">
                    <Link text="{dlg>summonerName}"
                          class="sapMLnk playerLink playerName"
                          wrapping="false"
                          press=".onAbrirHistoricoJogador"/>
                    <Image src="{dlg>championImg}" tooltip="{dlg>champion}" width="45px" height="45px"/>
                    <HBox alignItems="Center" justifyContent="Center" class="sapUiTinyMarginTop" renderType="Bare">
                      <Image src="{dlg>spell1_img}" tooltip="{dlg>spell1_name}"  width="20px" height="20px" class="sapUiTinyMarginEnd"/>
                      <Image src="{dlg>spell2_img}" tooltip="{dlg>spell2_name}"  width="20px" height="20px" class="sapUiTinyMarginEnd"/>
                      <Image src="{dlg>rune_img}"   tooltip="{dlg>runeMainName}" width="22px" height="22px"/>
                    </HBox>
                  </VBox>
                </VBox>

                <!-- DIREITA: KDA + itens -->
                <VBox width="55%" alignItems="End">
                  <HBox renderType="Bare">
                    <Text text="{dlg>kda}" class="sapUiSmallMarginEnd"/>
                  </HBox>

                  <HBox justifyContent="End" class="sapUiTinyMarginTop" renderType="Bare">
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/0}" visible="{= !!${dlg>itemsImgs/0} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/1}" visible="{= !!${dlg>itemsImgs/1} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/2}" visible="{= !!${dlg>itemsImgs/2} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/3}" visible="{= !!${dlg>itemsImgs/3} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/4}" visible="{= !!${dlg>itemsImgs/4} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/5}" visible="{= !!${dlg>itemsImgs/5} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/6}" visible="{= !!${dlg>itemsImgs/6} }"/></HBox>
                  </HBox>
                </VBox>

              </HBox>
            </items>
          </VBox>
        </VBox>

        <!-- ================= TIME VERMELHO ================= -->
        <VBox width="47%">
          <Title text="Time Vermelho" level="H4" width="100%" textAlign="End" class="sapUiSmallMarginBottom titleRed"/>
          <VBox items="{dlg>/team200}">
            <items>
              <HBox alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="sapUiTinyMarginBottom playerRow"
                    width="100%">

                <!-- ESQUERDA: KDA + itens -->
                <VBox width="55%" alignItems="Start">
                  <HBox renderType="Bare">
                    <Text text="{dlg>kda}" class="sapUiSmallMarginBegin"/>
                  </HBox>

                  <HBox justifyContent="Start" class="sapUiTinyMarginTop" renderType="Bare">
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/0}" visible="{= !!${dlg>itemsImgs/0} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/1}" visible="{= !!${dlg>itemsImgs/1} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/2}" visible="{= !!${dlg>itemsImgs/2} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/3}" visible="{= !!${dlg>itemsImgs/3} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/4}" visible="{= !!${dlg>itemsImgs/4} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/5}" visible="{= !!${dlg>itemsImgs/5} }"/></HBox>
                    <HBox class="itemSlot"><Image src="{dlg>itemsImgs/6}" visible="{= !!${dlg>itemsImgs/6} }"/></HBox>
                  </HBox>
                </VBox>

                <!-- DIREITA: Nome em cima, campeão abaixo, spells embaixo -->
                <VBox width="45%" alignItems="End">
                  <VBox class="playerBox" alignItems="Center">
                    <Link text="{dlg>summonerName}"
                          class="sapMLnk playerLink playerName"
                          wrapping="false"
                          press=".onAbrirHistoricoJogador"/>
                    <Image src="{dlg>championImg}" tooltip="{dlg>champion}" width="45px" height="45px"/>
                    <HBox alignItems="Center" justifyContent="Center" class="sapUiTinyMarginTop" renderType="Bare">
                      <Image src="{dlg>rune_img}"   tooltip="{dlg>runeMainName}" width="22px" height="22px"/>
                      <Image src="{dlg>spell1_img}" tooltip="{dlg>spell1_name}"  width="20px" height="20px" class="sapUiTinyMarginBegin"/>
                      <Image src="{dlg>spell2_img}" tooltip="{dlg>spell2_name}"  width="20px" height="20px" class="sapUiTinyMarginBegin"/>
                    </HBox>
                  </VBox>
                </VBox>

              </HBox>
            </items>
          </VBox>
        </VBox>

      </HBox>
    </VBox>

    <endButton>
      <Button text="Fechar" press="onFecharDetalhe"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
